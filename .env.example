# ==============================================================================
# PROJECT KENJIN - LOCAL ORCHESTRATOR ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE CONFIGURATION
DATABASE_URL=postgresql://kenjin:pick-a-real-password@127.0.0.1:5432/kenjin_local

# 2. REDIS CONFIGURATION
REDIS_URL=redis://localhost:6379/0

# 3. ORCHESTRATOR SECURITY
# Generate a secure key using: openssl rand -hex 32
ORCH_API_KEY="your_secure_randomly_generated_api_key_here"

# 4. GROQ LLM INTEGRATION
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# 5. BACKGROUND SCHEDULER CADENCES (Requires main.py patch)
FORECAST_INTERVAL_MIN=15
GATEKEEPER_INTERVAL_HOURS=1

# 6. ORCHESTRATOR HOST/PORT
KENJIN_HOST=127.0.0.1
KENJIN_PORT=8000

# 7. WINE / FBS MT5 CONFIGURATION
WINEPREFIX=/home/infoscience/.wine-kenjin
MT5_SHORTCUT_PATH="C:\users\infoscience\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\FBS MetaTrader 5\FBS MT5.lnk"
WINE_BIN=wine

# 8. HEADLESS STRATEGY-TESTER INVOCATION
MT5_PATH="env WINEPREFIX=\"/home/infoscience/.wine-kenjin\" wine \"C:\users\infoscience\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\FBS MetaTrader 5\FBS MT5.lnk\""

# 9. PYTHON ENVIRONMENT SELECTION (0 = venv, 1 = Conda)
USE_CONDA=0
CONDA_ENV_NAME=kenjin