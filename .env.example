# ==============================================================================
# PROJECT KENJIN - LOCAL ORCHESTRATOR ENVIRONMENT CONFIGURATION
# ==============================================================================
# QA NOTE: Copy this file to `.env` before running the FastAPI server.
# WARNING: NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MUST be the direct PostgreSQL connection string (Session or Transaction pooler), 
# NOT the Supabase REST/anon URL. The orchestrator uses this to bypass RLS 
# and act as the 'postgres' / 'service_role' admin.
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ------------------------------------------------------------------------------
# 2. ORCHESTRATOR SECURITY
# ------------------------------------------------------------------------------
# The shared-secret key used to authenticate requests from the MT5 Expert Advisor.
# QA CHECK: Ensure this matches the `InpOrchestratorApiKey` input parameter 
# when attaching the EA to a chart in MT5.
# Generate a strong key using: `openssl rand -hex 32`
ORCH_API_KEY="your_secure_randomly_generated_api_key_here"

# ------------------------------------------------------------------------------
# 3. GROQ LLM INTEGRATION
# ------------------------------------------------------------------------------
# Your API key from the Groq Cloud Console. Usually starts with 'gsk_'.
GROQ_API_KEY="gsk_your_groq_api_key_here"

# The specific model to route the forecast prompt to.
# QA NOTE: The system prompt relies on strict JSON output. 
# Recommended defaults: GPT OSS 20B or llama3-8b-8192.
GROQ_MODEL="GPT OSS 20B"

# ------------------------------------------------------------------------------
# 4. BACKGROUND SCHEDULER CADENCES (Optional Overrides)
# ------------------------------------------------------------------------------
# Interval for the `groq_forecast` job in minutes.
# System Default if omitted: 30
# QA NOTE: Decrease this to 5 or 10 during initial local integration testing 
# to verify Groq API connectivity faster, then revert to 30 for production.
FORECAST_INTERVAL_MIN=30

# Interval for the `gatekeeper` strategy evaluation job in hours.
# System Default if omitted: 4
GATEKEEPER_INTERVAL_HOURS=4